# local: filesystem R2/SQLite; wrangler: actual local Workers bindings; cloudflare: production.
PUBLISH_TARGET=wrangler
PUBLISH_SOURCE=content
PUBLISH_STATE_DIR=.publisher
PUBLISH_DEBOUNCE_MS=2000
PUBLISH_RECONCILE_MS=30000
PUBLISH_ALLOW_EMPTY=false
PUBLISH_REQUIRE_FLAG=false
# Set true to skip sharing-image generation during local iteration.
PUBLISH_SKIP_OG_IMAGES=false
# Optional: publishing waits until this file exists. Docker Compose sets its own path.
# PUBLISH_READY_FILE=/path/to/initial-sync-completed

# Used only when PUBLISH_TARGET=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=cromemadnd-blog-content
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
