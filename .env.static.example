# Dedicated token with Account / Workers Scripts / Edit permission.
# Do not reuse the SSR/R2/D1 publishing credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Absolute paths are recommended on servers. Source must contain public notes only.
STATIC_SOURCE=content
STATIC_STATE_DIR=.static-publisher
# Required for Docker; set only after the Bridge's first complete sync.
# STATIC_READY_FILE=/vault-data/.publisher-ready

# Merge edits before building, then retry failed deployments without rebuilding.
STATIC_DEBOUNCE_MS=2000
STATIC_RETRY_MS=10000
# Periodic content-hash scan catches missed filesystem events.
STATIC_SCAN_MS=30000
